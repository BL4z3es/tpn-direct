# tpn-server -- the VPN-server control API, installed by the tpn-server package's install.sh.
#
# `tpn serve` binds this node's tailnet IPv4 on :8443 (never a public interface) and checks
# every caller with `tailscale whois`. It only reads from the host's tailscaled socket.

[Unit]
Description=tpn VPN-server control API
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=exec
DynamicUser=yes
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
Environment=TPN_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
EnvironmentFile=-/etc/tpn-server/tpn-server.env
ExecStart=/opt/tpn-server/env/bin/tpn serve
Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
