# The tor expert bundle shipped in the Windows packages and the Android APK.
# Bump TOR_VERSION to the current Tor Browser release (it versions the bundle):
#   curl -s https://aus1.torproject.org/torbrowser/update_3/release/downloads.json | jq -r .version
TOR_VERSION=16.0
# Tor Browser Developers signing key (primary key fingerprint). The key itself is
# packaging/tor-signing-key.asc; a bundle whose signature does not chain to this exact
# fingerprint is rejected.
TOR_SIGNING_FPR=EF6E286DDA85EA2A4BA7DE684E2C6E8793298290
TOR_BASE_URL=https://archive.torproject.org/tor-package-archive/torbrowser
