# tpn-direct -- installed by deploy/install.sh as /etc/systemd/system/tpn-direct.service.
#
# deploy.sh never writes this file into /etc: it compares the two after every
# deploy and reports when they differ. Edit it here, push, then re-run
#     sudo /srv/tpn-direct/deploy/install.sh
#
# `tpn serve` binds the node's tailnet address (:8443), never the public interface, and
# checks every caller with `tailscale whois`. tailscaled is the host's own; this unit
# only talks to its socket.

[Unit]
Description=tpn-direct
After=network-online.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=exec
User=bl4z3
WorkingDirectory=/srv/tpn-direct
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
# The host's tailscaled, not the private one `tpn connect` starts under /var/lib/tpn.
Environment=TPN_TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock
# Secrets live here, readable by bl4z3 only, never in the repository. The
# dash means a missing file is not an error, so a host that has none still
# boots. Point ENV_FILE in deploy/easy-deploy.conf at the same file if the
# deploy hooks need them too.
EnvironmentFile=-/etc/tpn-direct/tpn-direct.env

ExecStart=/srv/tpn-direct/env/bin/tpn serve

Restart=on-failure
RestartSec=5s

# The whole filesystem is read-only to this process except WRITABLE_DIRS:
# a bug in the application cannot rewrite the code that serves it. The dash
# lets the unit start before install.sh has created the directory.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
